{
  "id": "gitlab-deployment",
  "vendor": "GitLab",
  "version": 1,
  "sources": ["gitlab"],
  "require": ["object_kind", "status", "deployment_id", "deployable_id", "environment", "short_sha", "commit_url", "project.path_with_namespace"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "environment",
      "body": "project.path_with_namespace",
      "url": "deployable_url",
      "correlation": "deployment_id",
      "lifecycle": "status"
    },
    "lv": {
      "blocked": "ongoing", "approved": "ongoing", "rejected": "ongoing", "running": "ongoing",
      "success": "ended", "failed": "ended", "canceled": "ended"
    }
  },
  "doc": "https://docs.gitlab.com/user/project/integrations/webhook_events/#deployment-events"
}
