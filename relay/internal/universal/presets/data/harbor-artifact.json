{
  "id": "harbor-artifact",
  "vendor": "Harbor",
  "version": 1,
  "sources": ["harbor"],
  "require": ["type", "occur_at", "operator", "event_data.resources[].digest", "event_data.repository.name", "event_data.repository.namespace", "event_data.repository.repo_full_name"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "event_data.repository.repo_full_name",
      "body": "type"
    }
  },
  "doc": "https://goharbor.io/docs/main/working-with-projects/project-configuration/configure-webhooks/"
}
