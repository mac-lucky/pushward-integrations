{
  "id": "jenkins-notification",
  "vendor": "Jenkins Notification plugin",
  "version": 1,
  "sources": ["jenkins"],
  "require": ["name", "url", "build.full_url", "build.number", "build.phase", "build.url"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "name",
      "body": "build.status",
      "url": "build.full_url",
      "correlation": "build.url",
      "lifecycle": "build.phase"
    },
    "lv": {"queued": "ongoing", "started": "ongoing", "completed": "ended", "finalized": "ended"}
  },
  "doc": "https://plugins.jenkins.io/notification/"
}
