{
  "id": "github-push",
  "vendor": "GitHub",
  "version": 1,
  "sources": ["github"],
  "require": ["ref", "before", "after", "created", "deleted", "forced", "base_ref", "compare", "pusher.name", "repository.full_name"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "repository.full_name",
      "body": "head_commit.message",
      "url": "compare"
    }
  },
  "doc": "https://docs.github.com/en/webhooks/webhook-events-and-payloads#push"
}
