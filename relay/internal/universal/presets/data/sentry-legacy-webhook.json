{
  "id": "sentry-legacy-webhook",
  "vendor": "Sentry",
  "version": 1,
  "sources": ["sentry"],
  "require": ["id", "project", "project_name", "project_slug", "level", "culprit", "message", "url", "triggering_rules[]", "event.event_id", "event.title"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "event.title",
      "body": "culprit",
      "url": "url",
      "correlation": "id",
      "severity": "level"
    },
    "sv": {"fatal": "critical", "error": "warning", "warning": "warning", "info": "info", "debug": "info"}
  },
  "doc": "https://github.com/getsentry/sentry/blob/master/src/sentry/sentry_apps/services/legacy_webhook/service.py"
}
