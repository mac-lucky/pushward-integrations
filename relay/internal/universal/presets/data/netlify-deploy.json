{
  "id": "netlify-deploy",
  "vendor": "Netlify",
  "version": 1,
  "sources": ["netlify"],
  "require": ["id", "site_id", "build_id", "state", "name", "admin_url", "deploy_ssl_url", "error_message", "context"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "name",
      "body": "error_message",
      "url": "admin_url",
      "correlation": "id",
      "lifecycle": "state"
    },
    "lv": {"building": "ongoing", "ready": "ended", "error": "ended"}
  },
  "doc": "https://docs.netlify.com/deploy/deploy-notifications/"
}
