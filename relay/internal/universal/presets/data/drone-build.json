{
  "id": "drone-build",
  "vendor": "Drone",
  "version": 1,
  "sources": ["drone"],
  "require": ["action", "repo.slug", "repo.config_path", "build.id", "build.repo_id", "build.number", "build.status", "build.event", "build.after", "build.source", "build.author_login"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "repo.slug",
      "body": "build.source",
      "correlation": "build.id",
      "lifecycle": "build.status"
    },
    "lv": {
      "pending": "ongoing", "running": "ongoing", "started": "ongoing", "blocked": "ongoing", "waiting_on_dependencies": "ongoing",
      "success": "ended", "failure": "ended", "error": "ended", "killed": "ended", "skipped": "ended", "declined": "ended"
    }
  },
  "doc": "https://docs.drone.io/webhooks/examples/"
}
