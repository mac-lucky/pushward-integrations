{
  "id": "jira-issue",
  "vendor": "Jira",
  "version": 1,
  "sources": ["jira"],
  "require": ["issue.id", "issue.key", "issue.self", "issue.fields.summary", "issue.fields.status.name"],
  "forbid": ["comment.id"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "issue.fields.summary",
      "body": "issue.fields.status.name"
    }
  },
  "doc": "https://support.atlassian.com/cloud-automation/docs/issue-data-jira-format-payload-for-send-web-request-action/"
}
