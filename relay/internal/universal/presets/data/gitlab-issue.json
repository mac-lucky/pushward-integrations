{
  "id": "gitlab-issue",
  "vendor": "GitLab",
  "version": 1,
  "sources": ["gitlab"],
  "require": ["object_kind", "object_attributes.id", "object_attributes.iid", "object_attributes.title", "object_attributes.state", "object_attributes.project_id", "object_attributes.confidential", "object_attributes.url", "project.path_with_namespace"],
  "forbid": ["object_attributes.source_branch", "object_attributes.note", "object_attributes.noteable_type"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "object_attributes.title",
      "body": "object_attributes.action",
      "url": "object_attributes.url"
    }
  },
  "doc": "https://docs.gitlab.com/user/project/integrations/webhook_events/#work-item-events"
}
