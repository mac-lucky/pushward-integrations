{
  "id": "github-check-run",
  "vendor": "GitHub",
  "version": 1,
  "sources": ["github"],
  "require": ["action", "check_run.id", "check_run.name", "check_run.status", "check_run.conclusion", "check_run.head_sha", "check_run.check_suite.id", "check_run.app.id"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "check_run.name",
      "body": "check_run.check_suite.head_branch",
      "url": "check_run.html_url",
      "correlation": "check_run.id",
      "lifecycle": "check_run.conclusion"
    },
    "lv": {
      "success": "ended", "failure": "ended", "neutral": "ended", "cancelled": "ended", "skipped": "ended",
      "timed_out": "ended", "action_required": "ended", "stale": "ended", "startup_failure": "ended"
    }
  },
  "doc": "https://docs.github.com/en/webhooks/webhook-events-and-payloads#check_run"
}
