{
  "id": "circleci-workflow",
  "vendor": "CircleCI",
  "version": 1,
  "sources": ["circleci"],
  "require": ["id", "type", "happened_at", "webhook.id", "workflow.id", "workflow.name", "workflow.status", "workflow.url", "pipeline.id", "pipeline.number", "project.slug", "project.name", "organization.id"],
  "forbid": ["job.id"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "project.name",
      "body": "workflow.status",
      "url": "workflow.url",
      "severity": "workflow.status"
    },
    "sv": {"success": "info", "canceled": "info", "failed": "warning", "error": "warning", "unauthorized": "warning"}
  },
  "doc": "https://circleci.com/docs/reference/outbound-webhooks-reference/"
}
