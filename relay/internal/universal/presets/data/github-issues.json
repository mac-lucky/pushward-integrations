{
  "id": "github-issues",
  "vendor": "GitHub",
  "version": 1,
  "sources": ["github"],
  "require": ["action", "issue.id", "issue.number", "issue.title", "issue.state", "issue.html_url", "issue.comments", "issue.user.site_admin"],
  "forbid": ["comment.id"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "issue.title",
      "body": "action",
      "url": "issue.html_url"
    }
  },
  "doc": "https://docs.github.com/en/webhooks/webhook-events-and-payloads#issues"
}
