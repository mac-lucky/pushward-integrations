{
  "id": "nextcloud-form",
  "vendor": "Nextcloud",
  "version": 1,
  "sources": ["nextcloud"],
  "require": ["event.class", "event.form.title", "event.form.hash", "event.submission.formId", "time"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "event.form.title",
      "body": "user.displayName"
    }
  },
  "doc": "https://docs.nextcloud.com/server/latest/admin_manual/webhook_listeners/index.html"
}
