{
  "id": "opsgenie",
  "vendor": "Opsgenie",
  "version": 1,
  "sources": ["opsgenie"],
  "require": ["action", "alert.alertId", "alert.tinyId", "alert.message", "alert.createdAt", "source.type"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "alert",
    "p": {
      "title": "alert.message",
      "body": "alert.description",
      "correlation": "alert.alertId",
      "severity": "alert.priority",
      "lifecycle": "action"
    },
    "sv": {"p1": "critical", "p2": "critical", "p3": "warning", "p4": "info", "p5": "info"},
    "lv": {
      "create": "ongoing", "acknowledge": "update", "unacknowledge": "update", "escalate": "update",
      "addnote": "update", "addtags": "update", "removetags": "update", "addteam": "update",
      "addrecipient": "update", "assignownership": "update", "takeownership": "update",
      "updatepriority": "update", "updatemessage": "update", "updatedescription": "update",
      "close": "ended", "delete": "ended"
    }
  },
  "doc": "https://support.atlassian.com/opsgenie/docs/opsgenie-edge-connector-alert-action-data/"
}
