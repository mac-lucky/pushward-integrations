{
  "id": "harbor-cloudevents",
  "vendor": "Harbor",
  "version": 1,
  "sources": ["harbor"],
  "require": ["specversion", "id", "requestid", "source", "type", "operator", "data.resources[].digest", "data.repository.namespace", "data.repository.repo_full_name"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "data.repository.repo_full_name",
      "body": "type"
    }
  },
  "doc": "https://goharbor.io/docs/main/working-with-projects/project-configuration/configure-webhooks/"
}
