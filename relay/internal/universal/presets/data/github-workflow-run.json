{
  "id": "github-workflow-run",
  "vendor": "GitHub",
  "version": 1,
  "sources": ["github"],
  "require": ["action", "workflow_run.id", "workflow_run.node_id", "workflow_run.name", "workflow_run.status", "workflow_run.conclusion", "workflow_run.workflow_id", "workflow_run.check_suite_id", "workflow_run.run_number", "workflow_run.head_sha", "workflow_run.repository.full_name"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "workflow_run.repository.full_name",
      "body": "workflow_run.name",
      "url": "workflow_run.html_url",
      "correlation": "workflow_run.id",
      "lifecycle": "workflow_run.conclusion"
    },
    "lv": {
      "success": "ended", "failure": "ended", "neutral": "ended", "cancelled": "ended", "skipped": "ended",
      "timed_out": "ended", "action_required": "ended", "stale": "ended", "startup_failure": "ended"
    }
  },
  "doc": "https://docs.github.com/en/webhooks/webhook-events-and-payloads#workflow_run"
}
