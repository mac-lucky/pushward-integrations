{
  "id": "github-workflow-run",
  "vendor": "GitHub",
  "version": 1,
  "sources": ["github"],
  "require": ["action", "workflow_run.id", "workflow_run.node_id", "workflow_run.name", "workflow_run.status", "workflow_run.conclusion", "workflow_run.workflow_id", "workflow_run.check_suite_id", "workflow_run.run_number", "workflow_run.head_sha"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "workflow_run.name",
      "body": "workflow_run.conclusion",
      "url": "workflow_run.html_url",
      "correlation": "workflow_run.id",
      "lifecycle": "workflow_run.status"
    },
    "lv": {
      "requested": "ongoing", "pending": "ongoing", "waiting": "ongoing", "queued": "ongoing", "in_progress": "ongoing",
      "completed": "ended"
    }
  },
  "doc": "https://docs.github.com/en/webhooks/webhook-events-and-payloads#workflow_run"
}
