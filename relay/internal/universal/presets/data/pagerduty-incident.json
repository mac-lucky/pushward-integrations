{
  "id": "pagerduty-incident",
  "vendor": "PagerDuty",
  "version": 1,
  "sources": ["pagerduty"],
  "require": ["event.id", "event.event_type", "event.resource_type", "event.occurred_at", "event.data.id", "event.data.type", "event.data.title", "event.data.status"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "alert",
    "p": {
      "title": "event.data.title",
      "body": "event.data.service.summary",
      "url": "event.data.html_url",
      "correlation": "event.data.id",
      "severity": "event.data.urgency",
      "lifecycle": "event.data.status"
    },
    "sv": {"high": "critical", "low": "warning"},
    "lv": {"triggered": "ongoing", "acknowledged": "ongoing", "resolved": "ended"}
  },
  "doc": "https://developer.pagerduty.com/docs/webhooks/v3-overview/"
}
