{
  "id": "lidarr-health",
  "vendor": "Lidarr",
  "version": 1,
  "sources": ["lidarr"],
  "require": ["eventType", "level", "message", "type"],
  "forbid": [],
  "alias_only": true,
  "mapping": {
    "v": 1,
    "k": "alert",
    "p": {
      "title": "message",
      "body": "type",
      "url": "wikiUrl",
      "correlation": "type",
      "severity": "level",
      "lifecycle": "eventType"
    },
    "sv": {"error": "critical", "warning": "warning", "notice": "info", "ok": "info"},
    "lv": {"health": "ongoing", "healthrestored": "ended"}
  },
  "doc": "https://github.com/Lidarr/Lidarr/blob/develop/src/NzbDrone.Core/Notifications/Webhook/WebhookBase.cs"
}
