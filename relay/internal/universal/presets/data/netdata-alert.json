{
  "id": "netdata-alert",
  "vendor": "Netdata",
  "version": 1,
  "sources": ["netdata"],
  "require": ["message", "alert", "info", "chart", "context", "space", "class", "severity", "date", "alert_url"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "alert",
      "body": "message",
      "url": "alert_url",
      "severity": "severity"
    },
    "sv": {"critical": "critical", "warning": "warning", "clear": "info"}
  },
  "doc": "https://learn.netdata.cloud/docs/alerts-&-notifications/notifications/centralized-cloud-notifications/webhook"
}
