{
  "id": "semaphore-pipeline",
  "vendor": "Semaphore",
  "version": 1,
  "sources": ["semaphore", "semaphoreci"],
  "require": ["version", "organization.id", "project.id", "project.name", "workflow.id", "workflow.initial_pipeline_id", "pipeline.id", "pipeline.state", "pipeline.result", "pipeline.yaml_file_name", "revision.reference_type"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "project.name",
      "body": "pipeline.result",
      "severity": "pipeline.result"
    },
    "sv": {"passed": "info", "stopped": "info", "canceled": "info", "failed": "warning"}
  },
  "doc": "https://docs.semaphore.io/using-semaphore/notifications"
}
