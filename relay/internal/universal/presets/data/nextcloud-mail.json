{
  "id": "nextcloud-mail",
  "vendor": "Nextcloud",
  "version": 1,
  "sources": ["nextcloud"],
  "require": ["event.class", "event.subject", "event.accountId", "time"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "event.subject",
      "body": "event.class"
    }
  },
  "doc": "https://docs.nextcloud.com/server/latest/admin_manual/webhook_listeners/index.html"
}
