{
  "id": "buildkite-build",
  "vendor": "Buildkite",
  "version": 1,
  "sources": ["buildkite"],
  "require": ["event", "build.id", "build.number", "build.state", "build.web_url", "build.branch", "build.commit", "pipeline.slug", "pipeline.name", "sender.name"],
  "forbid": ["job.id"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "progress",
    "p": {
      "title": "pipeline.name",
      "body": "build.branch",
      "url": "build.web_url",
      "correlation": "build.id",
      "lifecycle": "build.state"
    },
    "lv": {
      "creating": "ongoing", "scheduled": "ongoing", "running": "ongoing", "failing": "ongoing", "waiting": "ongoing", "canceling": "ongoing",
      "passed": "ended", "failed": "ended", "blocked": "ended", "canceled": "ended", "skipped": "ended", "not_run": "ended", "waiting_failed": "ended"
    }
  },
  "doc": "https://buildkite.com/docs/apis/webhooks/build-events"
}
