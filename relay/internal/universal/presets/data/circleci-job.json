{
  "id": "circleci-job",
  "vendor": "CircleCI",
  "version": 1,
  "sources": ["circleci"],
  "require": ["id", "type", "happened_at", "webhook.id", "job.id", "job.name", "job.number", "job.status", "workflow.id", "workflow.url", "pipeline.id", "project.slug", "organization.id"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "job.name",
      "body": "job.status",
      "url": "workflow.url",
      "severity": "job.status"
    },
    "sv": {"success": "info", "canceled": "info", "failed": "warning", "unauthorized": "warning"}
  },
  "doc": "https://circleci.com/docs/reference/outbound-webhooks-reference/"
}
