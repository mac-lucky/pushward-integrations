{
  "id": "bitbucket-push",
  "vendor": "Bitbucket Cloud",
  "version": 1,
  "sources": ["bitbucket"],
  "require": ["push.changes[].created", "push.changes[].closed", "push.changes[].forced", "push.changes[].truncated", "repository.full_name", "repository.uuid", "repository.scm", "actor.type"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "repository.full_name",
      "body": "push.changes[].new.target.message",
      "url": "push.changes[].links.html.href"
    }
  },
  "doc": "https://support.atlassian.com/bitbucket-cloud/docs/event-payloads/"
}
