{
  "id": "dockerhub-push",
  "vendor": "Docker Hub",
  "version": 1,
  "sources": ["dockerhub", "docker-hub"],
  "require": ["push_data.pushed_at", "push_data.pusher", "push_data.tag", "repository.repo_name", "repository.namespace", "repository.repo_url", "repository.is_official", "repository.star_count"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "repository.repo_name",
      "body": "push_data.tag",
      "url": "repository.repo_url"
    }
  },
  "doc": "https://docs.docker.com/docker-hub/repos/manage/webhooks/"
}
