{
  "id": "graylog",
  "vendor": "Graylog",
  "version": 1,
  "sources": ["graylog"],
  "require": ["event_definition_id", "event_definition_type", "event_definition_title", "job_definition_id", "job_trigger_id", "event.id", "event.event_definition_id", "event.timestamp", "event.message", "event.priority"],
  "forbid": [],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "event_definition_title",
      "body": "event.message",
      "severity": "event.priority"
    },
    "sv": {"0": "info", "1": "info", "2": "warning", "3": "critical", "4": "critical"}
  },
  "doc": "https://go2docs.graylog.org/current/interacting_with_your_log_data/alert_types.htm"
}
