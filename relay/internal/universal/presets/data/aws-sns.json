{
  "id": "aws-sns",
  "vendor": "Amazon SNS",
  "version": 1,
  "sources": ["aws-sns", "sns", "aws-cloudwatch", "cloudwatch"],
  "require": ["Type", "MessageId", "TopicArn", "Subject", "Message", "Timestamp", "SignatureVersion", "SigningCertURL", "UnsubscribeURL"],
  "forbid": ["SubscribeURL", "Token"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "Subject",
      "body": "Message"
    }
  },
  "doc": "https://docs.aws.amazon.com/sns/latest/dg/http-notification-json.html"
}
