{
  "id": "bitbucket-pullrequest",
  "vendor": "Bitbucket Cloud",
  "version": 1,
  "sources": ["bitbucket"],
  "require": ["pullrequest.id", "pullrequest.type", "pullrequest.title", "pullrequest.state", "pullrequest.source.branch.name", "pullrequest.destination.branch.name", "pullrequest.links.html.href", "repository.full_name", "repository.uuid", "actor.type"],
  "forbid": ["comment.id"],
  "alias_only": false,
  "mapping": {
    "v": 1,
    "k": "notification",
    "p": {
      "title": "pullrequest.title",
      "body": "pullrequest.state",
      "url": "pullrequest.links.html.href"
    }
  },
  "doc": "https://support.atlassian.com/bitbucket-cloud/docs/event-payloads/"
}
